# rust-crm local environment — copy to `.env` and adjust.
# `.env*` is gitignored. No secrets belong in this file; it only carries
# non-sensitive local development settings.

# Socket address the API server binds to.
CRM_API_ADDR=127.0.0.1:3000

# Directory the built Leptos/WASM frontend is served from. Build it with:
#   cargo build -p crm-web --target wasm32-unknown-unknown --release
#   wasm-bindgen --target web --out-dir web target/wasm32-unknown-unknown/release/crm-web.wasm
#   cp crates/crm-web/index.html web/
# If the directory is missing, the API starts in API-only mode and logs a warning.
CRM_WEB_DIR=./web

# `tracing` log filter for the API server.
RUST_LOG=crm_api=info,tower_http=info
